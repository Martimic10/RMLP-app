# App (use your real URL in production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe — https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret — see README "Stripe webhook" (whsec_ from CLI or Dashboard)
STRIPE_WEBHOOK_SECRET=whsec_...

# Firecrawl — https://www.firecrawl.dev/app (scrape live landing pages)
FIRECRAWL_API_KEY=fc-...

# OpenRouter — https://openrouter.ai/keys (routes to Claude, etc.)
OPENROUTER_API_KEY=sk-or-v1-...
# Optional — https://openrouter.ai/models (default: anthropic/claude-sonnet-4.5)
# OPENROUTER_MODEL=anthropic/claude-sonnet-4.5

# Resend (email delivery)
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Roast <hello@yourdomain.com>

# Upstash Redis — https://console.upstash.com → Create database → REST API
# (Vercel: Project → Storage → Upstash Redis → Connect — auto-fills these)
UPSTASH_REDIS_REST_URL=https://xxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=
